# --- Core Platform ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8000
JWT_SECRET=your-super-secret-jwt-key-change-in-production
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cybersec_platform

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Kafka (optional) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Tool Adapters ---
BURPSUITE_URL=http://127.0.0.1:1337
BURPSUITE_API_KEY=your-burpsuite-api-key

METASPLOIT_HOST=127.0.0.1
METASPLOIT_PORT=55553
METASPLOIT_PASSWORD=your-msf-password

NESSUS_URL=https://127.0.0.1:8834
NESSUS_ACCESS_KEY=your-nessus-access-key
NESSUS_SECRET_KEY=your-nessus-secret-key

SHODAN_API_KEY=your-shodan-api-key
CENSYS_API_ID=your-censys-api-id
CENSYS_API_SECRET=your-censys-api-secret

NUCLEI_TEMPLATE_DIR=/app/nuclei-templates

# --- OpenAI / LLM ---
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4

# --- Enterprise Integrations ---
# SIEM
SIEM_SPLUNK_URL=
SIEM_SPLUNK_TOKEN=
SIEM_ELASTIC_URL=
SIEM_ELASTIC_API_KEY=

# Notifications
SLACK_WEBHOOK_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@cybersec-platform.local
ALERT_RECIPIENTS=["admin@company.com"]

# Ticketing
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT=SEC

SERVICENOW_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# PagerDuty
PAGERDUTY_API_KEY=
PAGERDUTY_ROUTING_KEY=

# SSO / Auth
SSO_PROVIDERS=[]
