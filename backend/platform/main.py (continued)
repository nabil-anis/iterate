@app.get("/api/v1/reports/{report_id}/download")
async def download_report(report_id: str):
    """Download a report file."""
    from fastapi.responses import FileResponse
    import tempfile
    import os
    
    # Generate report content
    report_content = f"# Security Assessment Report\n\nReport ID: {report_id}\nGenerated: {datetime.utcnow().isoformat()}\n\n"
    
    # Write to temp file
    tmp = tempfile.NamedTemporaryFile(delete=False, suffix=".md", mode="w")
    tmp.write(report_content)
    tmp.close()
    
    return FileResponse(tmp.name, media_type="text/markdown", filename=f"report_{report_id}.md")


