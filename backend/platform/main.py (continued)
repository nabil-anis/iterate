@app.post("/api/v1/integrations/notifications/send")
async def send_notification(title: str, message: str, priority: str = "medium",
                            channels: Optional[List[str]] = None):
    """Send a custom notification."""
    priority_map = {
        "low": NotificationPriority.LOW,
        "medium": NotificationPriority.MEDIUM,
        "high": NotificationPriority.HIGH,
        "critical": NotificationPriority.CRITICAL,
    }
    
    channel_map = {
        "email": NotificationChannel.EMAIL,
        "slack": NotificationChannel.SLACK,
        "teams": NotificationChannel.TEAMS,
        "discord": NotificationChannel.DISCORD,
        "pagerduty": NotificationChannel.PAGERDUTY,
        "webhook": NotificationChannel.WEBHOOK,
        "sms": NotificationChannel.SMS,
    }
    
    selected_channels = [channel_map[c] for c in (channels or ["slack"]) if c in channel_map]
    
    result = await notifications.send(
        title=title, message=message,
        priority=priority_map.get(priority.lower(), NotificationPriority.MEDIUM),
        channels=selected_channels,
    )
    return result


