@app.post("/api/v1/reports/generate", status_code=status.HTTP_201_CREATED)
async def generate_report(scan_id: str, report_type: ReportType = ReportType.EXECUTIVE,
                          template_name: Optional[str] = None, format: str = "pdf"):
    """Generate a security assessment report."""
    try:
        findings = await analysis_engine.get_findings(scan_id=scan_id)
        scan = await orchestrator.get_scan(scan_id)
        
        report = Report(
            title=f"Security Assessment Report - {scan_id[:8]}",
            report_type=report_type,
            scan_id=scan_id,
            findings=findings,
            created_at=datetime.utcnow(),
        )
        
        # Generate report content based on type
        if report_type == ReportType.EXECUTIVE:
            report.executive_summary = _generate_executive_summary(findings, scan)
        elif report_type == ReportType.TECHNICAL:
            report.technical_details = _generate_technical_details(findings)
        elif report_type == ReportType.COMPLIANCE:
            report.compliance_mapping = _generate_compliance_mapping(findings)
        
        return {"report_id": report.id, "report_type": report_type.value, "format": format, "generated": True}
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


def _generate_executive_summary(findings: List, scan: Optional[Scan]) -> Dict:
    """Generate executive summary from findings."""
    severity_counts = {"critical": 0, "high": 0, "medium": 0, "low": 0, "info": 0}
    for f in findings:
        sev = f.get("severity", "info").lower()
        if sev in severity_counts:
            severity_counts[sev] += 1
    
    total = sum(severity_counts.values())
    risk_score = (severity_counts["critical"] * 10 + severity_counts["high"] * 7 +
                  severity_counts["medium"] * 4 + severity_counts["low"] * 1) / max(total, 1)
    
    return {
        "scan_targets": [t.target for t in scan.targets] if scan and hasattr(scan, 'targets') else [],
        "total_findings": total,
        "severity_breakdown": severity_counts,
        "risk_score": round(risk_score, 1),
        "risk_level": "critical" if risk_score >= 8 else "high" if risk_score >= 6 else "medium" if risk_score >= 4 else "low",
        "critical_findings": severity_counts["critical"],
        "high_findings": severity_counts["high"],
        "remediation_priority": "Immediate action required" if severity_counts["critical"] > 0 else "Schedule remediation",
    }


def _generate_technical_details(findings: List) -> Dict:
    """Generate technical details for findings."""
    return {
        "total_findings": len(findings),
        "by_type": {},
        "remediation_summary": {
            "available": sum(1 for f in findings if f.get("remediation")),
            "total": len(findings),
        },
        "technical_references": [f.get("sources", []) for f in findings[:10] if f.get("sources")],
    }


def _generate_compliance_mapping(findings: List) -> Dict:
    """Generate compliance framework mapping."""
    return {
        "frameworks_mapped": ["PCI DSS", "HIPAA", "GDPR", "SOC 2", "ISO 27001"],
        "finding_mappings": [],
        "gap_analysis": {"compliant": 0, "non_compliant": len(findings), "partial": 0},
    }


