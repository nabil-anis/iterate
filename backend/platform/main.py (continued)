@app.get("/api/v1/intelligence/cves")
async def search_cves(query: Optional[str] = None, product: Optional[str] = None,
                      vendor: Optional[str] = None, min_cvss: Optional[float] = None):
    """Search CVE database."""
    if product:
        results = await cve_db.search_by_product(product, vendor)
    elif query and query.upper().startswith("CVE-"):
