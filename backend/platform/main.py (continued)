async def _init_services():
    """Initialize all platform services."""
    # Register notification channels from config
    if hasattr(settings, 'slack_webhook_url') and settings.slack_webhook_url:
        await notifications.register_channel(
            NotificationChannel.SLACK,
            {"webhook_url": settings.slack_webhook_url}
        )
    
    if hasattr(settings, 'smtp_host') and settings.smtp_host:
        await notifications.register_channel(
            NotificationChannel.EMAIL,
            {
                "host": settings.smtp_host,
                "port": getattr(settings, 'smtp_port', 587),
                "username": getattr(settings, 'smtp_username', ''),
                "password": getattr(settings, 'smtp_password', ''),
                "from": getattr(settings, 'smtp_from', 'noreply@cybersec-platform.local'),
                "to": getattr(settings, 'alert_recipients', []),
            }
        )
    
    # Register SSO providers if configured
    if hasattr(settings, 'sso_providers'):
        for provider_config in settings.sso_providers:
            from platform.enterprise.sso import SSOProvider
            provider = SSOProvider(**provider_config)
            await sso.register_provider(provider)
    
    # Initialize SIEM sinks
    if hasattr(settings, 'siem_config'):
        for sink_name, sink_config in settings.siem_config.items():
            await siem.register_sink(sink_name, sink_config.get("type"), sink_config)
    
    logger.info("All services initialized successfully")


